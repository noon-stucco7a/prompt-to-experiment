# Copy to .env and fill in. NEVER commit .env.
# Flagsmith project: toggle-wars (ID 55963), environment: Development.
# All three values come from the Flagsmith console / CLI login; see README.

# Client-side environment key (SDK: demo page + simulator)
FLAGSMITH_ENVIRONMENT_KEY=

# Organisation API key, used by agent/apply.ts (Authorization: Api-Key <key>)
FLAGSMITH_API_KEY=

# Flagsmith API base (default is the cloud API)
FLAGSMITH_API_URL=https://api.flagsmith.com
